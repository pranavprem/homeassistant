# Home Assistant Configuration
# Copy this file to .env and fill in your values

# Path to Home Assistant config directory
HA_CONFIG_PATH=/volume1/media/config/homeassistant-config

# MQTT (Mosquitto)
MQTT_USER=mqtt
MQTT_PASSWORD=

# Govee (govee2mqtt)
GOVEE_EMAIL=
GOVEE_PASSWORD=
GOVEE_API_KEY=

# Dedicated Cloudflare tunnel token (home.pranavprem.com → localhost:8123)
CLOUDFLARED_TOKEN=
