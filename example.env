# Home Assistant Configuration
# Copy this file to .env and fill in your values

# Path to Home Assistant config directory
HA_CONFIG_PATH=/volume1/media/config/homeassistant-config

# Shared container settings
TZ=America/Los_Angeles
PUID=1000
PGID=1000
HOMEASSISTANT_PORT=8123

# Stable Docker network CIDRs for self-healing trusted proxy config.
# `make sync-trusted-proxies` and `make up` will use PROXY_SUBNET as the base
# trusted CIDR, then also add any detected host/logged proxy IPs when needed.
# Defaults intentionally live high in RFC1918 space to reduce collisions with
# pre-existing Docker bridges on the NAS.
PROXY_SUBNET=172.31.240.0/24
AUTOMATION_SUBNET=172.31.241.0/24

# Grocy
GROCY_PORT=9283
# Created automatically by make bootstrap when possible
GROCY_API_KEY=
GROCY_BASE_URL=http://grocy
GROCY_TIMEOUT_SECONDS=10
GROCY_VERIFY_SSL=false

# HomeButler (local control / Grocy API layer)
# Default is NAS-local only. Set this to the NAS LAN IP, for example
# 10.0.0.116, if Neo or another trusted LAN client needs direct access.
# Avoid 0.0.0.0 until HomeButler has auth in front of it.
HOMEBUTLER_BIND_IP=127.0.0.1
HOMEBUTLER_PORT=8000
HOMEBUTLER_ENV=production
HOMEBUTLER_LOG_LEVEL=info
# Stack registry (services/homebutler/app/registry/stacks.py) is the
# authoritative allowlist. This env var is now additive and can only ADD
# containers on top of the registry. Leave empty in most cases.
HOMEBUTLER_CONTROLLED_CONTAINERS=

# HomeButler control-plane — action routes
# Global kill-switch for /ops/actions*. Set to false to disable just the
# action endpoints without taking HomeButler down.
HOMEBUTLER_ACTIONS_ENABLED=true

# HomeButler repo mounts (host paths bind-mounted into the container).
# Override these to match your NAS. Actions for a stack stay marked
# available=false until its path exists and required executables (make,
# docker) are installed in the image.
HOMEBUTLER_HOMEASSISTANT_REPO_HOST=/volume1/docker/homeassistant
HOMEBUTLER_MEDIASERVER_REPO_HOST=/volume1/docker/mediaserver
HOMEBUTLER_MORPHEUS_REPO_HOST=/volume1/docker/morpheus
HOMEBUTLER_TOR_REPO_HOST=/volume1/docker/tor

# MQTT (Mosquitto)
# When Home Assistant runs on the Docker network, point the HA MQTT integration at host `mosquitto`
MQTT_USER=mqtt
MQTT_PASSWORD=

# Zigbee2MQTT
# Set this to the stable /dev/serial/by-id/... path for the coordinator on the
# NAS. Compose maps that one host device to /dev/zigbee inside the container.
ZIGBEE_ADAPTER_DEVICE=/dev/ttyUSB0
# zstack: Sonoff ZBDongle-P/CC2652. ember: HA Connect ZBT-1/SkyConnect/EFR32.
ZIGBEE_ADAPTER_TYPE=zstack
ZIGBEE2MQTT_BIND_IP=127.0.0.1
ZIGBEE2MQTT_PORT=43117
ZIGBEE2MQTT_LOG_LEVEL=info

# Govee (govee2mqtt)
GOVEE_EMAIL=
GOVEE_PASSWORD=
GOVEE_API_KEY=

# Dedicated Cloudflare tunnel token
# Typical routes after deploy:
# - home.pranavprem.com  -> http://homeassistant:8123
# - grocy.pranavprem.com -> http://grocy:80
CLOUDFLARED_TOKEN=
